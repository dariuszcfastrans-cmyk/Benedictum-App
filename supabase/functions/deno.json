{
  "nodeModulesDir": "auto",
  "imports": {
    "jsr:@supabase/supabase-js@2": "jsr:@supabase/supabase-js@2.47.4",
    "jsr:@std/assert": "jsr:@std/assert@1.0.0"
  },
  "tasks": {
    "test:unit": "deno test --allow-read --allow-env _shared/",
    "test:proxy": "deno test --allow-read --allow-env --allow-net session-proxy/",
